{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "services-section/services-selector",
  "version": "1.0.0",
  "title": "Services Section Selector",
  "category": "services-section",
  "description": "Choose and display your favorite services layout",
  "keywords": [
    "selector",
    "services"
  ],
  "textdomain": "services-section",
  "attributes": {
    "align": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "inserter": false
  },
  "editorScript": [
    "file:./index.js"
  ],
  "editorStyle": "file:./index.css"
}